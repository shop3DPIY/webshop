# Commerce provider selection. "payhip" today; swap this (and add a new
# provider implementation in src/lib/commerce) to migrate later.
COMMERCE_PROVIDER=payhip

# Master switch for real checkout. Keep "false" while 3DPIY is in
# development mode — components fall back to a disabled/"coming soon"
# state when this is not exactly "true".
NEXT_PUBLIC_COMMERCE_ENABLED=false

# --- Supabase (accounts, "My 3DPIY" library, 3DPIY Studio admin) ---------
# Leave all three unset to keep auth/account/admin pages in their
# "not connected yet" state — nothing else on the site needs these.
# See SETUP.md for how to create a project and fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payhip webhook (syncs purchases into Supabase orders/entitlements) --
# Shared secret you set in the Payhip dashboard's webhook config, verified
# in src/app/api/webhooks/payhip/route.ts.
PAYHIP_WEBHOOK_SECRET=

# --- Local ingest script (automatic draft products from a watched folder) -
# Shared secret the script at ~/3DPIY_ingest-script sends as the
# x-ingest-secret header, verified in src/app/api/studio/ingest/route.ts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must also be set in your HOSTING PROVIDER's env vars (Vercel/Netlify) for
# the script to reach the deployed site, not just local dev.
INGEST_AUTH_CODE=

# --- Staged launch switch -------------------------------------------------
# Leave unset locally (defaults to "live") so you keep seeing the full site
# while developing. Set this in your HOSTING PROVIDER's env vars (Vercel/
# Netlify dashboard) to control what's publicly reachable once deployed:
#   coming-soon  — only the coming-soon page, nothing else reachable at all
#   waitlist     — coming-soon page + sign up / sign in / account
#   live         — the full site, no gating (same as unset)
# 3DPIY Studio (/studio) always stays reachable regardless of this value.
NEXT_PUBLIC_SITE_MODE=live
